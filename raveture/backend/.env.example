# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Security Keys (
SECRET_KEY=dev-change-this-to-random-64-char-string-in-production
JWT_SECRET_KEY=dev-change-this-jwt-secret-64-chars-in-production

# Database
DATABASE_URL=postgresql://postgres:root@localhost:5432/raveture_db

# JWT Settings
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/minute

# File Storage (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=raveture-media
S3_REGION=us-east-1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# External Services
TICKETING_SERVICE_URL=http://localhost:5001
